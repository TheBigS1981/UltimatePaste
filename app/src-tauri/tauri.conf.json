{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UltimatePaste",
  "version": "1.1.2",
  "identifier": "io.github.thebigs1981.ultimatepaste",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "UltimatePaste",
        "url": "index.html",
        "width": 860,
        "height": 540,
        "minWidth": 600,
        "minHeight": 360,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://*.giphy.com https://*.klipy.com; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "TheBigS1981",
    "category": "Productivity",
    "shortDescription": "Fast clipboard & paste manager",
    "copyright": "MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["German", "English"], "displayLanguageSelector": false }
    }
  }
}
